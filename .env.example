# ---------------------------------------------------------------------------
# EVENT APP environment variables. Copy to .env.local for development.
# NEVER commit real values. Variables without NEXT_PUBLIC_ are server-only.
# ---------------------------------------------------------------------------

# Public URL of this deployment (used in auth emails and API docs)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase project (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SERVER ONLY — bypasses RLS. Used for invitations and the public website API.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: enable "Continue with Google" (configure the provider in Supabase Auth first)
NEXT_PUBLIC_ENABLE_GOOGLE_OAUTH=false

# Payment gateway (Phase 5). SERVER ONLY.
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Transactional email (optional; Supabase Auth sends auth emails itself). SERVER ONLY.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM="EVENT APP <no-reply@example.com>"

# Outgoing email for tickets and certificates (server only). With Gmail use
# smtp.gmail.com, port 465 and an app password (the same one used for Supabase SMTP).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="EVENT APP <you@example.com>"
